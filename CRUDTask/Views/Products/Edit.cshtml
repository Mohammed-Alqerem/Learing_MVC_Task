@model Product
<h1 class="my-5">Update Product</h1>


<form class="d-flex flex-column gap-3" method="post" action="/products/update">
    
        <input class="form-control" type="hidden" name="Id" value="@Model.Id" />
    
    <div>
        <label class="form-label">Name:</label>
        <input class="form-control" type="text" name="Name" value="@Model.Name"  />
    </div>
    <div>
        <label class="form-label">Price:</label>
        <input class="form-control" type="text" name="Price" value="@Model.Price" />
    </div>
    <div>
        <label class="form-label">Rate:</label>
        <input class="form-control" type="text" name="Rate" value="@Model.Rate" />
    </div>
    <div>
        <label class="form-label">Description:</label>
        <textarea name="Description" class="form-control">@Model.Description</textarea>
    </div>
    <input class="form-control btn btn-primary" type="submit" value="Update" />
</form>