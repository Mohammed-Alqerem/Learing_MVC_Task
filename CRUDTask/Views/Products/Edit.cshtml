@model Product
<h1 class="my-5">Update Product</h1>


<form class="d-flex flex-column gap-3" asp-action="update" asp-controller="products" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control"   />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
   
    <div>
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control"  />
        <span asp-validation-for="Price" class="text-danger"></span>

    </div>
   
    <div>
        <label asp-for="Rate" class="form-label"></label>
        <input asp-for="Rate" class="form-control"  />
        <span asp-validation-for="Rate" class="text-danger"></span>

    </div>
    
    <div>
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
   
    <input class="form-control btn btn-primary" type="submit" value="Update" />

</form>