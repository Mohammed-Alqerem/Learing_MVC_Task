@model List<Product>
<h1 class="mb-5 ">Our Products</h1>
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>

        @if(Model.Count > 0)
        {
            @foreach (var product in Model)
            {
                <div>
                    <tr>

                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Price$</td>
                        <td>
                            <a href="/products/edit/@product.Id" class="btn btn-success">Update</a>
                            <a href="/products/details/@product.Id" class="btn btn-primary">Details</a>
                            <a href="/products/delete/@product.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    
                </div>
               
                

            }
            

        }
        else
        {
            <tr >
                <td colspan="5">
                <h1 class="text-secondary text-center py-5">Empty</h1>

                </td>
            </tr>
        }

    </tbody>
</table>